## Python Sol

class Solution:
    def smallerNumbersThanCurrent(self, nums: list[int]) -> list[int]:
        temp = sorted(nums)
        d = {}
        res = []
        for i in range(len(temp)):
            if temp[i] not in d:
                d[temp[i]] = i

        for i in nums:
            res.append(d[i])
        
        return res
